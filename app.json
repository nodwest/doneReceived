{
  "expo": {
    "scheme": "donereceived",
    "name": "doneReceived",
    "slug": "doneReceived",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.doneReceived",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-router",
        {
          "root": "./app"
        }
      ],
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Kids Tasks uses your photos to attach them to task reports, wishes and profile pictures.",
          "cameraPermission": "Kids Tasks uses the camera to take photos for task reports, wishes and profile pictures.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Kids Tasks uses your location to show your family where you are.",
          "locationAlwaysAndWhenInUsePermission": "Kids Tasks shares your child's location with their family, including while the app is in the background.",
          "locationAlwaysPermission": "Kids Tasks shares your child's location with their family, including while the app is in the background.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "androidForegroundServiceIcon": "./assets/notification-icon.png"
        }
      ],
      "@maplibre/maplibre-react-native",
      "./plugins/with-windows-cmake-paths",
      "expo-image"
    ]
  }
}
